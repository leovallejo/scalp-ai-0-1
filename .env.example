# ── Required ──────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── Optional (defaults shown) ──────────────────────────────
# AI model to use via OpenRouter
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# Your deployed Vercel URL (used as HTTP-Referer header for OpenRouter)
OPENROUTER_SITE_URL=https://your-app.vercel.app

# App name sent to OpenRouter
OPENROUTER_APP_NAME=Precision Scalp Engine

# Binance API base (change for testnet: https://testnet.binance.vision)
BINANCE_API_BASE=https://api.binance.com

# Max candles allowed per backtest request
MAX_BACKTEST_BARS=1000

# Default risk per trade (1% = 0.01)
DEFAULT_RISK_PCT=0.01

# Starting paper balance in USD
INITIAL_PAPER_BALANCE=1000
